{#- sing-box AnyTLS server config, rendered by `tasks/config.yml`.

  One AnyTLS inbound on an internal loopback port. HAProxy passes the
  AnyTLS domain's TLS straight through (mode tcp, SNI match), so sing-box
  terminates TLS itself. Authentication reuses `naive_proxy_users`; the
  password doubles as the AnyTLS shared secret. Secrets come from role
  variables — never hardcode them here.

  TLS / certificate:
    * ACME (`_naive_proxy_anytls_acme`): sing-box obtains and renews its own
      certificate through an inline ACME `certificate_provider` (sing-box
      1.14+; the older inline `tls.acme` block is deprecated in 1.14 and
      removed in 1.16) backed by CertMagic — Let's Encrypt in production,
      local Pebble in the anytls-stress scenario.
      `disable_http_challenge` is set because only :443 is routed to the
      pod (no :80), so issuance uses TLS-ALPN-01. The provider manages the
      certificate asynchronously and the AnyTLS listener binds right after
      it starts, so the listener itself answers the `acme-tls/1` handshake
      that HAProxy forwards here: sing-box puts `acme-tls/1` ahead of the
      configured ALPN and serves the challenge certificate from CertMagic.
      `alternative_tls_port` names that internal listener port. CertMagic
      only binds it itself when nothing else holds it; leaving the default
      (443) would point CertMagic at HAProxy's public port instead.
    * Static (derived ACME false): a certificate prepared at
      `/anytls-certs/{fullchain,key}.pem` is used directly. This is the default
      in ordinary Molecule scenarios and never depends on a public CA.
-#}
{%- set _users = [] -%}
{%- for _name, _pass in naive_proxy_users.items() -%}
  {%- set _ = _users.append({'name': _name, 'password': _pass}) -%}
{%- endfor -%}
{%- if _naive_proxy_anytls_acme | bool -%}
  {%- set _acme_provider = (naive_proxy_molecule_mode | bool)
        | ternary(_naive_proxy_pebble_acme_server, naive_proxy_anytls_acme_provider) -%}
  {%- set _tls = {
    'enabled': true,
    'server_name': naive_proxy_anytls_domain,
    'certificate_provider': {
      'type': 'acme',
      'domain': [naive_proxy_anytls_domain],
      'data_directory': '/acme-data',
      'email': naive_proxy_anytls_acme_email,
      'provider': _acme_provider,
      'disable_http_challenge': true,
      'alternative_tls_port': _naive_proxy_anytls_port | int
    }
  } -%}
{%- else -%}
  {%- set _tls = {
    'enabled': true,
    'server_name': naive_proxy_anytls_domain,
    'certificate_path': '/anytls-certs/fullchain.pem',
    'key_path': '/anytls-certs/key.pem'
  } -%}
{%- endif -%}
{#- ALPN must be advertised so uTLS/browser clients (which send h2,http/1.1)
    can negotiate; on the ACME path sing-box keeps acme-tls/1 first and these
    values after it, so both challenge and normal handshakes negotiate.
    `_naive_proxy_anytls_alpn` is empty unless uTLS is enabled (see vars/main.yml). -#}
{%- if _naive_proxy_anytls_alpn -%}
  {%- set _tls = _tls | combine({'alpn': _naive_proxy_anytls_alpn}) -%}
{%- endif -%}
{{ {
  'log': {'level': naive_proxy_anytls_log_level, 'timestamp': true},
  'inbounds': [
    {
      'type': 'anytls',
      'tag': 'anytls-in',
      'listen': '127.0.0.1',
      'listen_port': _naive_proxy_anytls_port | int,
      'users': _users,
      'tls': _tls
    }
  ],
  'outbounds': [
    {'type': 'direct', 'tag': 'direct'}
  ]
} | to_nice_json }}
