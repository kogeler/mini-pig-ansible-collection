FROM {{ item.image }}

# `singbox_build_*` / `singbox_cronet_commit` come from
# `molecule/shared/base.yml` `provisioner.inventory.group_vars.all` and mirror
# the libbox.aar build inside the released SFA APK (sing-box tag, Go
# toolchain, build_libbox Android tags, build_shared linker flags, cronet-go
# commit). Building the same sing-box source the same way is the reason these
# scenarios can reproduce what Android users hit. The standard SagerNet Linux
# CLI release uses different (CLI) tags, so we compile from source and bake the
# CGO-disabled binary into the molecule instance image at
# /usr/local/bin/sing-box.
ARG SINGBOX_VERSION={{ singbox_build_version }}
ARG SINGBOX_TAGS={{ singbox_build_tags | join(',') }}
ARG SINGBOX_LDFLAGS="{{ singbox_build_ldflags }}"
ARG GO_VERSION={{ singbox_build_go_version }}
ARG CRONET_COMMIT={{ singbox_cronet_commit }}

RUN set -eux; \
    apt-get update -qq; \
    apt-get install -y -qq --no-install-recommends \
        systemd systemd-sysv python3 ca-certificates curl crun fuse-overlayfs; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) go_arch=amd64 ;; \
        arm64) go_arch=arm64 ;; \
        *) echo "unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" \
        | tar -xz -C /usr/local; \
    # sing-box with `with_naive_outbound` pulls in
    # github.com/sagernet/cronet-go. The `with_purego` tag tells
    # cronet-go to dlopen libcronet.so at runtime via purego, instead
    # of statically linking libcronet.a (which would require the
    # Chromium toolchain at build time). With both tags +
    # CGO_ENABLED=0 we avoid the Chromium C toolchain; libcronet.so is
    # taken from cronet-go AT THE COMMIT sing-box pins
    # (.github/CRONET_GO_VERSION) — the same file sing-box's own purego
    # Linux release ships — and placed in /usr/local/lib so cronet-go's
    # loader_unix.findLibrary() picks it up automatically.
    #
    # SINGBOX_LDFLAGS is sing-box release/LDFLAGS (= build_shared.
    # LinkerFlags, used by build_libbox for libbox.aar):
    #   * `-X runtime.godebugDefault=multipathtcp=0,tlssha1=1` — the same
    #     GODEBUG defaults SFA ships (no MPTCP, SHA-1 TLS signatures allowed);
    #   * `-checklinkname=0` — the `badlinkname` tag makes sing-box's
    #     internal `common/badtls` package `go:linkname` into crypto/tls,
    #     which Go 1.22+ rejects unless the linker skips the check.
    # The version `-X` and `-s -w -buildid=` match LinkerFlags' non-debug
    # build; `-trimpath -buildvcs=false` match build_libbox sharedFlags.
    PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
        go install -trimpath -buildvcs=false \
        -ldflags="-X github.com/sagernet/sing-box/constant.Version=${SINGBOX_VERSION#v} ${SINGBOX_LDFLAGS} -s -w -buildid=" \
        -tags="${SINGBOX_TAGS}" \
        "github.com/sagernet/sing-box/cmd/sing-box@${SINGBOX_VERSION}"; \
    install -m 0755 /root/go/bin/sing-box /usr/local/bin/sing-box; \
    install -d /usr/local/lib; \
    curl -fsSL \
        "https://raw.githubusercontent.com/sagernet/cronet-go/${CRONET_COMMIT}/lib/linux_${go_arch}/libcronet.so" \
        -o /usr/local/lib/libcronet.so; \
    chmod 0644 /usr/local/lib/libcronet.so; \
    /usr/local/bin/sing-box version; \
    rm -rf /usr/local/go /root/go /root/.cache; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    systemctl mask getty@tty1.service; \
    echo "root:100000:65536" > /etc/subuid; \
    echo "root:100000:65536" > /etc/subgid

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
